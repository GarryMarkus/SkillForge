# ==============================================================================
# SkillForge Server - Git Ignore
# ==============================================================================

# Python bytecode & packaging
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.whl
.installed.cfg
MANIFEST
dist/
build/

# Virtual environments
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.python-version

# Environment files & secrets
.env
.env.*
*.env
!.env.example
local_settings.py
.secrets
secrets.json
*.secrets.*
credentials.json
*service-account*.json
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks

# Local SQLite database, static collect & user uploads
db.sqlite3
*.sqlite
*.sqlite3*
*.db
media/
resumes/
staticfiles/

# Celery, Redis & logs
celerybeat-schedule
celerybeat-schedule.*
dump.rdb
*.rdb
logs/
*.log
*.pid
*.seed
*.pid.lock

# Test & QA caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Scratch, merge, IDE & OS files
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
